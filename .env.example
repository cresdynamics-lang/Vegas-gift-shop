# Storefront (copy to .env — do not commit .env)
VITE_API_URL=http://localhost:5000
VITE_SITE_URL=http://localhost:5173

# Meta Pixel (Events Manager → Settings → Pixel ID)
VITE_META_PIXEL_ID=

# Google Analytics 4 (Admin → Data streams → Measurement ID, format G-XXXXXXXX)
VITE_GA4_MEASUREMENT_ID=

# Optional: Google Ads tag if you use gtag for Ads (same gtag.js as GA4 when linked)
# VITE_GOOGLE_ADS_ID=
