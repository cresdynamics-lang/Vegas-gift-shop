# Copy to .env and fill in real values (do not commit .env)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/vegas_gift_shop
JWT_SECRET=change-me-to-a-long-random-string
PORT=5000

# WhatsApp order confirmations (Meta Cloud API — https://developers.facebook.com/docs/whatsapp/cloud-api)
# Create a Meta app, add WhatsApp, get Phone number ID + permanent access token.
WHATSAPP_ENABLED=true
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional: approved template name (required for messaging customers outside 24h window)
# WHATSAPP_ORDER_TEMPLATE=order_received
# WHATSAPP_TEMPLATE_LANG=en

# Public site URL (product links in Merchant / Meta feeds — must match live domain)
PUBLIC_SITE_URL=https://vegasgifts.co.ke
STORE_BRAND_NAME=Vegas Gift Shop

# Meta Conversions API (Events Manager → Settings → Conversions API → Generate token)
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# Catalog feeds (register these URLs in Merchant Center / Meta Commerce Manager):
#   GET {PUBLIC_SITE_URL or API host}/feeds/google.xml
#   GET {PUBLIC_SITE_URL or API host}/feeds/meta-catalog.csv
#   GET {PUBLIC_SITE_URL or API host}/feeds/products.json
